{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@root": ["."],
      "@database/*": ["src/database/*"],
      "@logger": ["logger/logger.js"],
      "@features/*": ["src/features/*"],
      "@shared/*": ["src/shared/*"],
      "@docs/*": ["../docs/*"]
    },
    "module": "es2022",
    "moduleResolution": "Node",
    "target": "ES2020",
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true
  },
  "include": ["src", "logger", "types", "docs", "../testing/test.js"],
  "exclude": ["node_modules", "dist"]
}
